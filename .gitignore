# ============================================================
# .gitignore - Transportation Security System
# ============================================================

# Python
__pycache__/
*.py[cod]
*.so
.Python
venv/
env/
ENV/
.venv/
env/
ENV/
dist/
build/
*.egg-info/
*.egg
.eggs/

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb
*.ipynb_checkpoints

# Data Files
*.csv
*.db
*.sqlite
*.sqlite3
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# VS Code
.vscode/
*.code-workspace
*.code-snippets

# Python Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
dmypy.json
*.log

# OS Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# IDE Files
*.swp
*.swo
*~
.idea/
*.iml

# Project Specific
*.dat
*.pkl
*.pickle
*.h5
*.pb
*.onnx
model/
models/

# Streamlit
.streamlit/
.secrets.toml
*.streamlit/

# Temporary Files
*.tmp
*.temp
*.cache
*.bak
*.backup

# Environment Variables
.env
.env.local
.env.*.local

# Uploads
uploads/
downloads/